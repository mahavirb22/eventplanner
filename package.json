{
  "name": "celebration-planner",
  "version": "0.1.0",
  "description": "GenAI-powered celebration and event planning assistant",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --coverage --forceExit",
    "test:e2e": "npx playwright test --config=playwright.config.cjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.3.0",
    "@google/generative-ai": "^0.24.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "coverageDirectory": "coverage"
  }
}
